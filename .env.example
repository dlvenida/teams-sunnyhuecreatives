# Database
DATABASE_URL=postgresql://shc:shc@localhost:5440/shc

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=7

# Admin seed (created on first startup if no admin exists)
ADMIN_EMAIL=janelaurine@gmail.com
ADMIN_PASSWORD=change-me

# Email (Resend)
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM_EMAIL=onboarding@resend.dev
ADMIN_NOTIFY_EMAIL=janelaurine@gmail.com

# CORS
CORS_ORIGINS=http://localhost:5190

# App
APP_URL=http://localhost:5190
API_URL=http://localhost:8090

# Grok / xAI — get a key at https://console.x.ai
XAI_API_KEY=
GROK_MODEL=grok-4

# Headless Grok Bot control API — your bot sends this as the X-Agent-Key header
# Generate one with: openssl rand -hex 32
AGENT_API_KEY=
