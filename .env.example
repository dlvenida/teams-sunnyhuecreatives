# Database
DATABASE_URL=postgresql://shc:shc@localhost:5440/shc

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=7

# Admin seed (created on first startup if no admin exists)
ADMIN_EMAIL=janelaurine@gmail.com
ADMIN_PASSWORD=change-me

# Demo users, clients, and VAs (auditor@sunnyhue.local, myra/gem/arby/peter). Default off.
# Set true only on a local or demo database. Never set this in production.
SEED_DEMO_DATA=false

# Email (Resend)
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM_EMAIL=onboarding@resend.dev
ADMIN_NOTIFY_EMAIL=janelaurine@gmail.com

# CORS
CORS_ORIGINS=http://localhost:5190

# App
APP_URL=http://localhost:5190
API_URL=http://localhost:8090

# Grok / xAI — get a key at https://console.x.ai
XAI_API_KEY=
GROK_MODEL=grok-4

# Engagement screenshot reading (optional).
# When XAI_API_KEY is set, the server can read engagement screenshots with that existing key.
# ENGAGEMENT_VISION_MODEL overrides the model used only for screenshot reading.
# If neither a local tesseract binary nor XAI_API_KEY is available, the screenshot
# stays in Needs review because it could not be read. Nothing is counted, and that
# zero is not labeled as a short daily total. Do not put a real key in this file.
ENGAGEMENT_VISION_MODEL=

# Headless Grok Bot control API — your bot sends this as the X-Agent-Key header
# Generate one with: openssl rand -hex 32
AGENT_API_KEY=
